# Copy to .env.local and fill in. Placeholders only: never commit real values.

# ── Public (shipped in the browser bundle) ─────────────────────────────────────
# The anon key is public by design. contacts has RLS off, so anyone holding it can read and
# write contacts directly through PostgREST; see "Threat model" in CLAUDE.md.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional. Unset: the takeover card and the system-health banner show plain text, no link.
NEXT_PUBLIC_TAKEOVER_URL=
NEXT_PUBLIC_BEELINK_VNC_URL=

# ── Server only ────────────────────────────────────────────────────────────────
# Left empty on purpose: a copied template fails closed until you fill these in.
# Operator login: OPERATOR_PASSWORD 16+ characters, SESSION_SECRET 32+ random characters.
# Unset or too short: every page and API route except /login, /api/login and /api/logout is
# refused, and /api/login answers 503.
OPERATOR_PASSWORD=
SESSION_SECRET=

# Signs approvals; same value as the GitHub secret and the Beelink's approval.env (32+ chars).
# Unset or too short: Submit answers 503 before any approval is recorded.
APPROVAL_SIGNING_KEY=

# "beelink": Submit only approves and the Beelink's apply-submit timer submits.
# Unset: Submit dispatches apply_agent_submit.yml on GitHub (needs GITHUB_DISPATCH_TOKEN).
APPLY_SUBMIT_HOST=

# GitHub token with actions:write on the agent repo ("Run Agent" button, GitHub-hosted submit).
# Unset: Run Agent answers 500, and so does Submit unless APPLY_SUBMIT_HOST=beelink.
GITHUB_DISPATCH_TOKEN=your-github-token

# Anthropic key for /api/extract and /api/preview-draft. Unset: those routes fail.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gmail OAuth (send-draft, update-draft, trash-message). Run scripts/capture-gmail-token.mts to
# obtain the refresh token. Unset: those routes answer 401 "Gmail auth not configured".
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token
