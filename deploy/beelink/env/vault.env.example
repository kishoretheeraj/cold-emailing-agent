# Template for /etc/job-agent/vault.env on the Beelink (root:root, chmod 0600). Loaded ONLY by
# apply-prepare.service and apply-submit.service. VAULT_KEY encrypts the per-site account
# passwords in /var/lib/job-agent/vault.bin (credential_vault.py). Generate it once, on the
# Beelink, and keep a copy somewhere safe -- without it the saved site passwords are unreadable:
#   /opt/job-agent/.venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
VAULT_KEY=
