# Submits applications the operator approved (apply_worker.py --submit -> apply_agent.submit).
# The ONLY Beelink unit with APPLY_AGENT_ARMED=1. submit() still refuses any row that is not
# approved, not hash-bound to the reviewed preview, or not signed by the contact-manager
# (APPROVAL_SIGNING_KEY, loaded only here from approval.env). It never calls Claude: answers come
# from the stored, reviewed preview, so it never holds the Claude subscription token.
[Unit]
Description=Apply worker: submit operator-approved applications on display :1
After=xvfb@1.service network-online.target
Requires=xvfb@1.service
JoinsNamespaceOf=xvfb@1.service
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=jobagent
Group=jobagent
WorkingDirectory=/opt/job-agent
EnvironmentFile=/etc/job-agent/base.env
EnvironmentFile=/etc/job-agent/approval.env
Environment=HOME=/var/lib/job-agent
Environment=DISPLAY=:1
Environment=APPLY_BROWSER_HEADLESS=0
Environment=APPLY_BROWSER_CHANNEL=chrome
Environment=APPLY_GENERIC_ADAPTER=none
Environment=APPLY_TAKEOVER_ENABLED=1
Environment=APPLY_DISPLAY_LOCK=/var/lib/job-agent/display1.lock
Environment=APPLY_AGENT_ARMED=1
ExecStart=/opt/job-agent/.venv/bin/python apply_worker.py --submit
TimeoutStartSec=3600
MemoryMax=2560M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/job-agent /var/lib/job-agent
