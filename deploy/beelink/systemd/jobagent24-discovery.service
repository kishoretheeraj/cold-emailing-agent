# Namespaced 24/7 stack (deploy/beelink/RUNBOOK-24-7.md). Same code as job-sourcing.service, own checkout,
# venv, secrets and state. Zero model calls.
[Unit]
Description=jobagent24 discovery: find, filter and dedup postings (no model calls)
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=jobagent
Group=jobagent
WorkingDirectory=/opt/jobagent24
EnvironmentFile=/etc/jobagent24/base.env
Environment=HOME=/var/lib/jobagent24
Environment=APPLY_AGENT_ARMED=
ExecStartPre=/opt/jobagent24/.venv/bin/python -c "import config; config.require_secrets()"
ExecStart=/opt/jobagent24/.venv/bin/python job_sourcing.py
TimeoutStartSec=3600
MemoryMax=512M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jobagent24 /var/lib/jobagent24
