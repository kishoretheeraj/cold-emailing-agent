# Reply/sent-draft monitor (monitor.py), on demand only. GitHub Actions' monitor.yml is the scheduled
# runner; do not add a timer here without disabling that workflow.
[Unit]
Description=jobagent24 monitor: one monitor.py pass (manual)
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=jobagent
Group=jobagent
WorkingDirectory=/opt/jobagent24
EnvironmentFile=/etc/jobagent24/base.env
Environment=HOME=/var/lib/jobagent24
Environment=APPLY_AGENT_ARMED=
ExecStartPre=/opt/jobagent24/.venv/bin/python -c "import config; config.require_secrets()"
ExecStart=/opt/jobagent24/.venv/bin/python monitor.py
TimeoutStartSec=900
MemoryMax=512M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jobagent24 /var/lib/jobagent24
