# Prepare-only apply worker on display :2 (never submits, never armed). Submitting stays with the old
# apply-submit.service, the only armed unit in the repo. Sets APPLY_RESUME_V2 so rows get documents from
# resume/v2 + the ATS API clients. Own display (:2), display lock, sessions dir and browser state.
# JoinsNamespaceOf= is load-bearing: the X11 socket lives in xvfb@2's private /tmp.
[Unit]
Description=jobagent24 apply: prepare applications on display :2 (never submits)
After=xvfb@2.service network-online.target
Requires=xvfb@2.service
JoinsNamespaceOf=xvfb@2.service
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=jobagent
Group=jobagent
WorkingDirectory=/opt/jobagent24
EnvironmentFile=/etc/jobagent24/base.env
EnvironmentFile=/etc/jobagent24/claude.env
Environment=HOME=/var/lib/jobagent24
Environment=DISPLAY=:2
Environment=CLAUDE_CLI_PATH=/var/lib/job-agent/.local/bin/claude
Environment=APPLY_CLAUDE_BACKEND=subscription
Environment=RESUME_CLAUDE_BACKEND=subscription
Environment=APPLY_RESUME_V2=1
Environment=APPLY_BROWSER_HEADLESS=0
Environment=APPLY_BROWSER_CHANNEL=chrome
Environment=APPLY_GENERIC_ADAPTER=none
Environment=APPLY_UNIVERSAL_ENABLED=1
Environment=APPLY_UNIVERSAL_PLATFORMS=generic,workable,smartrecruiters
Environment=APPLY_TAKEOVER_ENABLED=1
Environment=APPLY_DISPLAY_LOCK=/var/lib/jobagent24/display2.lock
Environment=APPLY_SESSIONS_DIR=/var/lib/jobagent24/sessions
Environment=APPLY_AGENT_ARMED=
ExecStartPre=/opt/jobagent24/.venv/bin/python -c "import config; config.require_secrets()"
ExecStart=/opt/jobagent24/.venv/bin/python apply_worker.py --prepare
TimeoutStartSec=5400
MemoryMax=2560M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jobagent24 /var/lib/jobagent24
