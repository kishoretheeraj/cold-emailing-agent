# Copy this file to .env and fill in your values.
# Never commit .env to git.

ANTHROPIC_API_KEY=sk-ant-your-key-here
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key used ONLY by supabase_sync.py (dashboard sync). This is a
# full-database credential: set it in the Beelink systemd unit environment file, never in this
# file, never in .env committed anywhere, never in git. Leave the placeholder empty.
SUPABASE_SERVICE_ROLE_KEY=
